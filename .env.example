# =============================================================
#  ZIDICARHIRE configuration
#  Copy to .env and fill in every value marked FILL_ME.
#  Never share this file or upload it to GitHub.
# =============================================================

# ---------- Django ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=FILL_ME
# true on your computer, false on PythonAnywhere
DEBUG=true
# Local: localhost,127.0.0.1   Live: www.zidicarhire.com,zidicarhire.com,YOURUSERNAME.pythonanywhere.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Live: https://www.zidicarhire.com,https://zidicarhire.com
CSRF_TRUSTED_ORIGINS=
# Local: http://localhost:8000   Live: https://www.zidicarhire.com
SITE_URL=http://localhost:8000

# ---------- PayHero M-Pesa (https://app.payhero.co.ke) ----------
# Option A: PayHero > API Keys > "Basic Auth Token" (include the word Basic)
PAYHERO_AUTH_TOKEN=Basic FILL_ME
# Option B: leave the token blank and fill the API username and password instead
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# PayHero > Payment Channels > ID of the channel linked to your Safaricom till
PAYHERO_CHANNEL_ID=FILL_ME
# Your till number and the name customers see on the M-Pesa prompt (shown on receipts)
MPESA_TILL_NUMBER=FILL_ME
MPESA_ACCOUNT_NAME=ZIDICARHIRE
# true = no real M-Pesa prompts, payments succeed automatically (testing only)
FAKE_PAYMENTS=true

# ---------- Email (Gmail: Google Account > Security > App passwords) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=FILL_ME@gmail.com
EMAIL_HOST_PASSWORD=FILL_ME
DEFAULT_FROM_EMAIL=ZIDICARHIRE <FILL_ME@gmail.com>
# Who gets new booking and chat alerts (comma-separated)
ADMIN_NOTIFY_EMAILS=FILL_ME@gmail.com

# ---------- Business details (website, emails and receipts) ----------
BUSINESS_NAME=ZIDICARHIRE
BUSINESS_PHONE=+2547FILL_ME
# WhatsApp number in international format without + (e.g. 254712345678)
BUSINESS_WHATSAPP=2547FILL_ME
BUSINESS_EMAIL=bookings@zidicarhire.com
BUSINESS_ADDRESS=FILL_ME, Nairobi
BUSINESS_LOCATION=Nairobi, Kenya
# Optional: printed on receipts if filled
KRA_PIN=
# Opening hours used for pick-up/return time choices (24h format)
BUSINESS_OPEN_TIME=07:00
BUSINESS_CLOSE_TIME=20:00

# ---------- Booking rules ----------
MIN_RENTAL_DAYS=1
MAX_RENTAL_DAYS=60
# Minutes an unpaid booking holds the car
BOOKING_HOLD_MINUTES=10

# ---------- Uploads ----------
MAX_UPLOAD_MB=5
