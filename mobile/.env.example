# Copy to .env and change if needed. EXPO_PUBLIC_ values are built into the app (never put secrets here).

# The Django site the app talks to. Leave as the live site, or point at your computer while developing:
# use your computer's Wi-Fi address (not localhost) so the phone can reach it, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=https://www.zidicarhire.com
