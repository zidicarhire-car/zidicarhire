{
  "expo": {
    "name": "ZidiCarHire",
    "slug": "zidicarhire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zidicarhire",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1C2340",
    "ios": {
      "bundleIdentifier": "com.zidicarhire.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zidicarhire.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C2340",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C2340",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Staff choose car photos to add to the fleet.",
          "cameraPermission": "Staff take photos of cars to add to the fleet.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b7059890-8213-4f7b-ac04-3a5b4df92715"
      }
    },
    "owner": "telongsoftwareinc"
  }
}
